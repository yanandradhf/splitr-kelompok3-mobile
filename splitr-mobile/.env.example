# Environment Variables Template
# ⚠️ WAJIB: Copy file ini ke .env dan isi dengan data aktual
# File .env tidak ada di git untuk keamanan

# Ngrok URL (WAJIB - minta ke backend developer)
EXPO_PUBLIC_NGROK_URL=https://b0f3b2591755.ngrok-free.app

# External API Keys (OPTIONAL - untuk fitur scan receipt)
EXPO_PUBLIC_GROQ_API_KEY=your-groq-api-key-here
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here
EXPO_PUBLIC_OCR_SPACE_API_KEY=your-ocr-space-api-key-here
EXPO_PUBLIC_GOOGLE_VISION_API_KEY=your-google-vision-api-key-here

# Optional: OpenAI API Key
EXPO_PUBLIC_OPENAI_API_KEY=your-openai-api-key-here

# CARA SETUP:
# 1. cp .env.example .env
# 2. Edit .env dengan data aktual
# 3. npm install && npx expo start